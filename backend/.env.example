# MySQL Configuration (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_db
DB_USER=root
DB_PASSWORD=

# Application Settings
PORT=3001
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# ZKTeco K40 Device Configuration
ZKTeco_IP=192.168.1.201
ZKTeco_PORT=4370
ZKTeco_TIMEOUT=5000
ZKTeco_AUTO_CONNECT=true

# Development Settings
# Set to true to use mock database instead of MySQL
USE_MOCK_DB=false

# Email Configuration
# Set to true to use mock email (logs to console) - recommended for development
USE_MOCK_EMAIL=true

# Gmail Configuration (only needed when USE_MOCK_EMAIL=false)
# 1. Enable 2-factor authentication on your Gmail
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below (NOT your regular Gmail password)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
